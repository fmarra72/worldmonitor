# Exclude local desktop build artifacts and sidecar binaries from deployments
# These files are large and not needed by the Vercel-hosted frontend/API

# Tauri build outputs
src-tauri/target/
src-tauri/bundle/

# Sidecar and bundled node binaries
src-tauri/sidecar/
src-tauri/**/node

# macOS disk images and app bundles
**/*.dmg
**/*.app

# Rust/Cargo build artifacts (safety)
target/

# Common local artifacts
.DS_Store

# Never deploy api test files: every non-underscore file under api/ becomes a
# live serverless function, and a deployed *.test.mjs executes its whole
# node:test suite (production env + Sentry) on every request (WORLDMONITOR-VD).
# Guarded by tests/deploy-config.test.mjs.
api/**/*.test.mjs

# ------ Ivix World Monitor curation (Hobby plan: 12 Serverless Functions max) ------
# Keeping only: market, news, economic, trade, resilience, conflict, sanctions,
# supply-chain (v1), bootstrap.js, rss-proxy.js — plus headroom for /api/latam.
# Everything else below stays in the repo but is excluded from deployment.
# Re-enable a domain later by deleting its line here.
#
# NOTE: api/mcp/ and api/health.js are deliberately NOT listed here even though
# their domains aren't part of our curated set. scripts/docs-stats.mjs (run by
# the postinstall/prebuild inventory:facts step) reads these files directly off
# disk at build time to generate doc/catalog artifacts, regardless of whether
# they're deployed as routes:
#   - api/mcp/ui/registry.ts, api/mcp/ui/shell.ts
#   - api/mcp/registry/rpc-tools.ts, api/mcp/registry/cache-tools.ts, api/mcp/registry/index.ts
#   - api/health.js
# Only the loose top-level MCP route files (api/mcp.ts, api/mcp-proxy.ts,
# api/docs-mcp.ts) are excluded below — those are routes, not data modules.
# Verified via full-text search of scripts/{docs-stats,generate-inventory-facts,
# generate-public-product-facts,generate-product-config,source-attribution}.mjs
# for every read('api/...') call — this is the complete list, not a guess.

